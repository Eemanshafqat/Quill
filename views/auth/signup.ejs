<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Sign up' }) %></head>
<body class="auth-page">
  <main class="auth-card">
    <h1 class="brand">Quill</h1>
    <h2>Create your Quill account</h2>
    <%- include('../partials/flash') %>
    <% if (errors.general) { %><p class="field-error"><%= errors.general %></p><% } %>

    <form method="POST" action="/signup" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email %>" />
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>

      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
      <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>

      <label for="confirmPassword">Confirm Password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required />
      <% if (errors.confirmPassword) { %><p class="field-error"><%= errors.confirmPassword %></p><% } %>

      <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    </form>

    <p class="auth-alt">Already have an account? <a href="/login">Log in</a></p>
  </main>
</body>
</html>
